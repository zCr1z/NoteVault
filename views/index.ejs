<%- include('partials/header') %>

<!-- Hero Section - Task 3: Advanced CSS + animations -->
<div class="hero-section text-center py-5 mb-5 rounded-4">
  <div class="hero-content">
    <h1 class="display-4 fw-bold text-white mb-3 animate-fade-in">
      <i class="fas fa-book-open me-3"></i>NoteVault
    </h1>
    <p class="lead text-white-50 mb-4">Your smart student notes manager. Organize, access, and never forget.</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-light btn-lg px-4">
          <i class="fas fa-th-large me-2"></i>Go to Dashboard
        </a>
      <% } else { %>
        <a href="/auth/register" class="btn btn-light btn-lg px-4">
          <i class="fas fa-user-plus me-2"></i>Get Started
        </a>
        <a href="/auth/login" class="btn btn-outline-light btn-lg px-4">
          <i class="fas fa-sign-in-alt me-2"></i>Login
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Features - Task 3: Complex multi-section layout -->
<div class="row g-4 mb-5">
  <div class="col-md-4">
    <div class="feature-card card h-100 border-0 shadow-sm text-center p-4">
      <div class="feature-icon bg-primary bg-opacity-10 rounded-circle mx-auto mb-3">
        <i class="fas fa-pen-fancy fa-2x text-primary"></i>
      </div>
      <h5 class="fw-bold">Create Notes</h5>
      <p class="text-muted">Quickly jot down notes for any subject with a clean editor.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="feature-card card h-100 border-0 shadow-sm text-center p-4">
      <div class="feature-icon bg-success bg-opacity-10 rounded-circle mx-auto mb-3">
        <i class="fas fa-shield-alt fa-2x text-success"></i>
      </div>
      <h5 class="fw-bold">Secure & Private</h5>
      <p class="text-muted">JWT authentication keeps your notes safe and accessible only to you.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="feature-card card h-100 border-0 shadow-sm text-center p-4">
      <div class="feature-icon bg-warning bg-opacity-10 rounded-circle mx-auto mb-3">
        <i class="fas fa-mobile-alt fa-2x text-warning"></i>
      </div>
      <h5 class="fw-bold">Fully Responsive</h5>
      <p class="text-muted">Works perfectly on desktop, tablet, and mobile devices.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
