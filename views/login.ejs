<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-5 col-lg-4">
    <div class="card shadow border-0 rounded-4">
      <div class="card-body p-4">
        <h3 class="fw-bold text-center mb-4"><i class="fas fa-sign-in-alt me-2 text-primary"></i>Login</h3>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger">
            <% errors.forEach(e => { %><div><i class="fas fa-exclamation-circle me-1"></i><%= e %></div><% }) %>
          </div>
        <% } %>

        <form action="/auth/login" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" name="email" class="form-control"
              value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
              placeholder="your@email.com" required>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Password</label>
            <div class="input-group">
              <input type="password" name="password" id="loginPw" class="form-control" required>
              <button class="btn btn-outline-secondary" type="button"
                onclick="document.getElementById('loginPw').type = document.getElementById('loginPw').type === 'password' ? 'text' : 'password'">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="fas fa-sign-in-alt me-2"></i>Login
          </button>
        </form>

        <hr>
        <p class="text-center mb-0">Don't have an account? <a href="/auth/register">Register here</a></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
